{
 "about": "Runs only on a made-up floor (?stress=40&replay=0&mix=busy&tick=1, whose first four requests are one of each kind: a question, an approval, a question with options, a request for more access): nothing is sent to any agent. The bottom text bar is gone; the time rail's icon shows and hides the rail; a card is folded away and brought back from its agent's icon; then every card is answered by its own buttons as it comes up (Decline, Answer in chat and typed there, Deny, an option, Allow once), each request resolving and its card going; a message typed to a made-up agent in its chat is accepted. Piece B: Decline opens a line for why (Enter on it empty sends the plain no), and after each answer the page goes to the next waiting question, whose transcript is closed again before the next card is answered.",
 "actions": [
  {
   "waitFor": "card-fold:",
   "timeout": 15000,
   "save": "f"
  },
  {
   "assert": {
    "mock": "stress",
    "connected": true,
    "lacks": "line",
    "cards.shown": true
   },
   "stop": true
  },
  {
   "assert": {
    "railShown": false,
    "lacks": "rail:play"
   }
  },
  {
   "shot": "01-card"
  },
  {
   "log": "the time rail's own icon"
  },
  {
   "click": "rail-toggle"
  },
  {
   "assert": {
    "railShown": true,
    "railOn": true,
    "has": "rail:play"
   }
  },
  {
   "shot": "02-rail-on"
  },
  {
   "click": "rail-toggle"
  },
  {
   "assert": {
    "railShown": false,
    "railOn": false,
    "lacks": "rail:play"
   }
  },
  {
   "log": "fold the card away and bring it back from its agent's icon"
  },
  {
   "click": "card-fold:*",
   "reveal": true,
   "save": "f"
  },
  {
   "assert": {
    "cards.foldedColumns": "$f.column",
    "!cards.column": "$f.column",
    "cards.open": "$f.column"
   }
  },
  {
   "shot": "03-folded"
  },
  {
   "click": "readout:$f.column",
   "reveal": true
  },
  {
   "assert": {
    "reply": "reply:$f.column",
    "!cards.foldedColumns": "$f.column",
    "!cards.column": "$f.column"
   },
   "note": "the click brings the card back unfolded and opens the agent's transcript; no card is drawn for the agent whose transcript is open (its question stands at the transcript's top)"
  },
  {
   "shot": "04-unfolded"
  },
  {
   "key": "Escape",
   "after": 500
  },
  {
   "assert": {
    "reply": null,
    "cards.column": "$f.column",
    "!cards.foldedColumns": "$f.column"
   },
   "note": "the transcript closed: the card is on the floor again"
  },
  {
   "log": "answer every card by its own buttons as it comes up, oldest first: each kind once at least"
  },
  {
   "if": "card-deny:*",
   "reveal": true,
   "then": [
    {
     "click": "card-deny:*",
     "reveal": true,
     "save": "d0"
    },
    {
     "until": {
      "!cards.open": "$d0.column"
     },
     "timeout": 5000
    },
    {
     "assert": {
      "!cards.open": "$d0.column",
      "toast": null
     }
    },
    {
     "log": "answered by deny: $d0.column"
    },
    {
     "assert": {
      "focused": null,
      "transcript.open": false
     },
     "after": 400,
     "note": "card follow-up (planner 2026-11-18): an answer on a floor card stays on the floor: no transcript opens and no agent is focused; the next waiting card shows where it stands"
    }
   ]
  },
  {
   "if": "card-option:*",
   "reveal": true,
