{
  "about": "The usage panel on whatever floor the server opens; sends nothing. The gauge stands at the left end of the top-right row (usage gauge, map, rail icon, plug, folder: one top, one size, even gaps, none touching). A click opens the ledger at the right edge: both plans' windows, the floor's total, and the agents by what they spent, three at first, with 'show 3 more' under them when there are more. Each 'show 3 more' adds three until the list is complete and the button is gone; 'top 3 only' folds it back to three. The ledger never runs past the rail (it scrolls inside), its text is at most 11 px, hovering a row rings its column and clicking a row focuses it. Esc closes it. Needs a floor with at least four agents that have recorded calls.",
  "actions": [
    {"waitFor": "usage", "timeout": 20000},
    {"key": "Shift", "until": {"usage.loaded": true}, "max": 400},
    {"assert": {"usage.loaded": true, "usage.open": false, "buttons.order": "providers,usage,minimap,rail-toggle,connectors,pick-folder", "buttons.inRow": true, "buttons.overlap": false}, "stop": true},
    {"hover": "usage", "after": 400},
    {"assert": {"hover": "usage"}},
    {"shot": "01-closed"},
    {"log": "the gauge opens the ledger: three agents, 'show 3 more' under them"},
    {"click": "usage", "after": 900},
    {"assert": {"usage.open": true, "usage.shown": 3, "usage.more": true, "usage.less": false, "usage.withinWindow": true, "has": "usage-panel:more"}, "stop": true},
    {"shot": "02-open-top3"},
    {"click": "usage-panel:more", "after": 400},
    {"assert": {"usage.shown": 6, "usage.less": true, "usage.withinWindow": true}},
    {"shot": "03-show-more"},
    {"log": "'show 3 more' until the list is complete: the button is gone"},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"if": "usage-panel:more", "then": [{"click": "usage-panel:more", "after": 250}]},
    {"assert": {"usage.more": false, "usage.less": true, "usage.withinWindow": true, "lacks": "usage-panel:more"}},
    {"shot": "04-expanded"},
    {"click": "usage-panel:less", "after": 400},
    {"assert": {"usage.shown": 3, "usage.more": true, "usage.less": false, "usage.withinWindow": true}},
    {"shot": "05-collapsed"},
    {"log": "a row: hover rings its column, a click focuses it"},
    {"hover": "usage-row:*", "save": "r", "after": 400},
    {"assert": {"usage.ring": "$r.id"}},
    {"click": "$r", "after": 900},
    {"assert": {"focused": "$r.id", "usage.open": true}},
    {"shot": "06-row-focused"},
    {"assert": {"reply": "reply:$r.id"}, "note": "the row's click opened that agent's transcript (the chat window went), the reply box writing to it"},
    {"key": "Escape", "after": 400},
    {"assert": {"reply": null, "usage.open": true}, "note": "the first Esc closes the transcript, the topmost thing, and leaves the ledger open"},
    {"key": "Escape", "after": 400},
    {"assert": {"usage.open": false, "lacks": "usage-panel"}},
    {"shot": "07-closed-again"}
  ]
}
